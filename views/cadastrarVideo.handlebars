<h1>Cadastrar Vídeo</h1>

<form action="/videos" method="POST">
  <div>
    <label>Título:</label>
    <input type="text" name="titulo">
  </div>
  <br>
  <div>
    <label>Criador:</label>
    <input type="text" name="criador">
  </div>
  <br>
  <div>
    <label>Descrição:</label>
    <input type="text" name="descricao">
  </div>
  <br>
  <div>
    <label>Visualizações:</label>
    <input type="number" name="visualizacoes">
  </div>
  <br>
  <div>
    <label>Curtidas:</label>
    <input type="number" name="curtidas">
  </div>
  <br>
  <div>
    <label>Hashtag Principal:</label>
    <input type="text" name="hashtag">
  </div>
  <br>
  <div>
    <label>URL do Vídeo:</label>
    <input type="text" name="urlVideo">
  </div>
  <br>
  <div>
    <label>URL da Thumbnail:</label>
    <input type="text" name="urlThumb">
  </div>
  <br>
  <button type="submit">Cadastrar</button>
</form>